{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nma112-exhibition-sync",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-08-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "SHEET_CSV_URL": "https://docs.google.com/spreadsheets/d/1MxKJMaBHAe4d2xEc_IcCQQGDNk8nhfRIyQXUV7zFqaw/export?format=csv",
    "DATA_REFRESH_INTERVAL_MS": "30000"
  },
  "r2_buckets": [
    {
      "binding": "EXHIBITION_BUCKET",
      "bucket_name": "nma112-exhibition-assets"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  }
}
